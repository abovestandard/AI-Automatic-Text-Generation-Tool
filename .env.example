# Platform API (Node.js/Express)
PORT=3001

# PostgreSQL — required (replace user, password, host, database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_content?schema=public"

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Optional: auto-create first CRM admin on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=yourpassword123
ADMIN_NAME=Platform Admin

# Optional global API keys (can also be set per-project in CRM)
OPENAI_API_KEY=
GEMINI_API_KEY=
